# Wayfund environment. Copy to .env.local (pnpm dev) or .env (docker compose) and fill in.
# Never commit real values. Integrations left empty switch themselves off.

# --- Core -------------------------------------------------------------------
# Local Docker Postgres (docker compose up db), or your Neon Free connection string:
#   postgres://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://wayfund:wayfund@localhost:5432/wayfund
# Public URL of the app (your Cloudflare Tunnel URL when testing on a phone).
APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 33
AUTH_SECRET=

# --- Sign-in (E1) -----------------------------------------------------------
# Google: https://console.cloud.google.com/apis/credentials (OAuth client, Web)
#   Redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Facebook: https://developers.facebook.com/apps (Facebook Login)
#   Redirect URI: <APP_URL>/api/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
# Email magic links through Resend (https://resend.com). Without a key, outside production,
# links are printed in the server log instead. EMAIL_TRANSPORT=log forces that.
AUTH_RESEND_KEY=
EMAIL_FROM="Wayfund <hello@wayfund.app>"
EMAIL_TRANSPORT=
EMAIL_LOG_DIR=

# --- Storage (profile photos, PDFs, exports) ----------------------------------
# Local: SeaweedFS from docker compose (any keys work). Cloud: Cloudflare R2 S3 endpoint and keys.
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_BUCKET=wayfund
S3_ACCESS_KEY_ID=wayfund
S3_SECRET_ACCESS_KEY=wayfund-local-secret

# --- Monitoring (E0-6) --------------------------------------------------------
# Server-side
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Browser-side, baked in at build time (Docker build args in CI)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
# Source map upload during builds (optional)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
